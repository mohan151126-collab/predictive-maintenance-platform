# MongoDB (local development only)
MONGO_ROOT_USER=pm_admin
MONGO_ROOT_PASSWORD=change_me_local_only
MONGO_URI=mongodb://pm_admin:change_me_local_only@localhost:27017/predictive_maintenance?authSource=admin

# Kafka
KAFKA_BROKERS=localhost:9092

# MQTT
MQTT_URL=mqtt://localhost:1883

# JWT (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
